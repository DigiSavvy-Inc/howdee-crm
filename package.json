{
	"name": "howdee-crm",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"test": "vitest run",
		"deploy": "node scripts/deploy.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.14",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/papaparse": "^5.5.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.8",
		"wrangler": "^4.159.0"
	},
	"dependencies": {
		"@digisavvy/block-editor": "^0.5.0",
		"marked": "^18.0.5",
		"papaparse": "^5.5.3"
	}
}
