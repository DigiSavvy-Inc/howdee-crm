<div style="font-size:0;line-height:0;margin:8px 0 12px;border-top:4px solid #000000;padding-top:16px;text-align:left;"><div class="ds-ms" style="display:inline-block;width:100%;max-width:178px;vertical-align:top;"><div style="padding:0 12px 12px 0;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.4;text-align:left;"><div style="font-size:20px;font-weight:700;line-height:1.25;margin:0 0 4px;">1</div><div style="font-size:13px;line-height:1.4;">a</div></div></div><div class="ds-ms" style="display:inline-block;width:100%;max-width:178px;vertical-align:top;"><div style="padding:0 12px 12px 0;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.4;text-align:left;"><div style="font-size:20px;font-weight:700;line-height:1.25;margin:0 0 4px;">2</div><div style="font-size:13px;line-height:1.4;">b</div></div></div><div class="ds-ms" style="display:inline-block;width:100%;max-width:178px;vertical-align:top;"><div style="padding:0 12px 12px 0;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.4;text-align:left;"><div style="font-size:20px;font-weight:700;line-height:1.25;margin:0 0 4px;">3</div><div style="font-size:13px;line-height:1.4;">c</div></div></div></div>
<div style="font-size:0;line-height:0;margin:8px 0 12px;text-align:left;"><div class="ds-ms" style="display:inline-block;width:100%;max-width:268px;vertical-align:top;"><div style="padding:0 12px 12px 0;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.4;text-align:left;"><div style="font-size:20px;font-weight:700;line-height:1.25;margin:0 0 4px;">x</div><div style="font-size:13px;line-height:1.4;">y</div></div></div><div class="ds-ms" style="display:inline-block;width:100%;max-width:268px;vertical-align:top;"><div style="padding:0 12px 12px 0;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.4;text-align:left;"><div style="font-size:20px;font-weight:700;line-height:1.25;margin:0 0 4px;">&nbsp;</div><div style="font-size:13px;line-height:1.4;">&nbsp;</div></div></div></div>
<div style="margin:0 0 16px;"><img src="https://img.test/a.png" alt="A" width="544" style="display:block;width:100%;max-width:544px;height:auto;border-radius:6px;"></div>
<div style="margin:0 0 16px;"><a href="https://c.test"><img src="https://img.test/b.png" alt="B" width="200" style="display:block;width:100%;max-width:200px;height:auto;border-radius:6px;"></a></div>
<div style="margin:0 0 16px;"><img src="https://img.test/c.png" alt="C" width="218" style="display:block;width:100%;max-width:218px;height:auto;border-radius:6px;"></div>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:0 0 16px;"><tr><td valign="middle"><table role="presentation" border="0" cellpadding="0" cellspacing="0"><tr><td bgcolor="#ffffff" style="background-color:#ffffff;border-radius:12px;padding:12px 16px;"><img src="https://img.test/d.png" alt="D" width="48" style="display:block;width:48px;max-width:100%;height:auto;border-radius:0px;"></td></tr></table></td></tr></table>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:0 0 16px;"><tr><td valign="middle"><img src="https://img.test/e.png" alt="E" width="120" style="display:block;width:120px;max-width:100%;height:auto;border-radius:6px;"></td><td valign="middle" style="padding-left:12px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:22px;font-weight:700;line-height:1.2;">Wordmark</td></tr></table>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" align="left" style="margin:8px 0 18px;"><tr><td style="background:#000000;border-radius:8px;font-size:16px;line-height:20px;"><a href="https://d.test" style="display:inline-block;padding:11px 22px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#f5f3ed;text-decoration:none;">Left</a></td></tr></table>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin:8px auto 18px;"><tr><td style="background:#000000;border-radius:8px;font-size:16px;line-height:20px;"><a href="https://d.test" style="display:inline-block;padding:11px 22px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#f5f3ed;text-decoration:none;">Centre</a></td></tr></table>
<div style="text-align:right;font-size:0;line-height:0;margin:8px 0 8px;"><div class="ds-cta" style="display:inline-block;vertical-align:middle;margin:0 24px 10px 0;"><table role="presentation" border="0" cellpadding="0" cellspacing="0"><tr><td style="background:#000000;border-radius:8px;font-size:16px;line-height:20px;"><a href="https://d.test" style="display:inline-block;padding:11px 22px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#f5f3ed;text-decoration:none;">Right</a></td></tr></table></div><div class="ds-cta-link" style="display:inline-block;vertical-align:middle;margin:0 0 10px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:1.4;"><a href="mailto:a@b.test" style="font-size:16px;line-height:1.4;color:#000000;text-decoration:underline;">or here</a></div></div>

<div style="border-top:1px solid #000000;margin:24px 0;font-size:0;line-height:0;">&nbsp;</div>
<div style="height:12px;font-size:0;line-height:0;">&nbsp;</div>
<div style="height:56px;font-size:0;line-height:0;">&nbsp;</div>
{{#if tag:hot}}<p style="font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;margin:0 0 16px;">Hot only</p>{{/if}}
<div style="text-align:left;font-size:0;margin:0 0 16px;"><div class="stack" style="display:inline-block;width:100%;max-width:260px;vertical-align:top;"><div style="padding:0 6px;font-size:16px;line-height:1.6;"><p style="font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;margin:0 0 16px;">Left cell</p></div></div><div class="stack" style="display:inline-block;width:100%;max-width:260px;vertical-align:top;"><div style="padding:0 6px;font-size:16px;line-height:1.6;"><div style="margin:0 0 16px;"><img src="https://img.test/f.png" alt="F" width="248" style="display:block;width:100%;max-width:248px;height:auto;border-radius:6px;"></div></div></div></div>
<div style="text-align:left;font-size:0;margin:0 0 16px;"><div class="stack" style="display:inline-block;width:100%;max-width:169px;vertical-align:top;"><div style="padding:0 6px;font-size:16px;line-height:1.6;"><div style="font-family:Inter,Helvetica,Arial,sans-serif;font-size:17px;font-weight:700;line-height:1.25;margin:0 0 14px;">x</div></div></div><div class="stack" style="display:inline-block;width:100%;max-width:169px;vertical-align:top;"><div style="padding:0 6px;font-size:16px;line-height:1.6;"></div></div><div class="stack" style="display:inline-block;width:100%;max-width:169px;vertical-align:top;"><div style="padding:0 6px;font-size:16px;line-height:1.6;"><table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin:8px auto 18px;"><tr><td style="background:#000000;border-radius:8px;font-size:16px;line-height:20px;"><a href="https://e.test" style="display:inline-block;padding:11px 22px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#f5f3ed;text-decoration:none;">Go</a></td></tr></table></div></div></div></td></tr></table>"
`;

exports[`back-compat: no design attributes = unchanged output > kitchen sink: email, page and text snapshots 2`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page</title>
<style>
  :root { color-scheme: light; }
  body { margin:0; padding:0; background:#fafafa;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    font-size:17px; line-height:1.65; color:#1f2328; }
  .page { max-width:720px; margin:0 auto; padding:48px 24px 80px; }
  h1 { font-size:32px; line-height:1.2; margin:32px 0 20px; }
  h2 { font-size:22px; line-height:1.3; margin:28px 0 12px; }
  p { margin:0 0 16px; }
  ul, ol { margin:0 0 16px; padding-left:22px; }
  a { color:#2563eb; }
  img { max-width:100%; height:auto; border-radius:8px; display:block; }
  hr { border:none; border-top:1px solid #e5e7eb; margin:28px 0; }
  blockquote { margin:0 0 16px; padding:4px 0 4px 16px; border-left:3px solid #e5e7eb; color:#57606a; }
  h3 { font-size:18px; line-height:1.35; margin:22px 0 10px; }
  /* #329: no space above a heading that opens its container or follows a heading / eyebrow. */
  :is(.page, .b-sec, .col) > :is(h1, h2, h3):first-child,
  :is(h1, h2, h3, .b-eyebrow) + :is(h1, h2, h3) { margin-top:0; }
  .b-img { margin:0 0 16px; }
  .b-callout { margin:0 0 16px; padding:14px 16px; background:#f4f4f5; border-radius:8px; }
  .b-btn { margin:8px 0 20px; }
  .btn { display:inline-block; background:#2563eb; color:#ffffff; padding:11px 22px;
    border-radius:8px; text-decoration:none; font-weight:600; }
  .cols { display:grid; gap:24px; margin:0 0 16px; }
  .cols-2 { grid-template-columns:1fr 1fr; }
  .cols-3 { grid-template-columns:1fr 1fr 1fr; }
  @media (max-width:600px) { .cols-2, .cols-3 { grid-template-columns:1fr; } }
  .b-sec { margin:0 0 16px; border-radius:12px; font-family:Inter,Helvetica,Arial,sans-serif; }
  .b-sec.full { border-radius:0; margin:0; }
  .b-sec > :last-child { margin-bottom:0; }
  .b-sec a { color:inherit; }
  .b-sec .btn { background:var(--btn-bg); color:var(--btn-fg); }
  .b-eyebrow { display:flex; align-items:center; gap:10px; margin:0 0 16px; font-size:13px;
    line-height:1.4; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; }
  .b-sec[style*="text-align:center"] .b-eyebrow { justify-content:center; }
  .b-eyebrow.accent { color:var(--acc, #1a9ec4); }
  .b-eyebrow-rule { flex:0 0 28px; border-top:2px solid currentColor; }
  .b-display { font-size:52px; line-height:1.05; letter-spacing:-0.02em; margin:0 0 20px; }
  .b-ms { display:grid; grid-template-columns:repeat(var(--n), minmax(0, 1fr)); gap:16px; margin:8px 0 24px; }
  .b-ms.rule { border-top:4px solid currentColor; padding-top:16px; }
  .b-ms strong { display:block; font-size:20px; line-height:1.25; }
  .b-ms span { display:block; font-size:13px; line-height:1.4; }
  .b-steps { list-style:none; padding:0; counter-reset:step; }
  .b-steps li { counter-increment:step; display:flex; gap:16px; margin:0; padding:14px 0;
    border-top:1px solid var(--hair, #e3e3e3); }
  .b-steps li:first-child { border-top:0; }
  .b-steps li::before { content:counter(step); flex:0 0 28px; height:28px; border:2px solid var(--acc, #1a9ec4);
    border-radius:50%; text-align:center; line-height:28px; font-size:14px; font-weight:700; }
  .b-btn-row { display:flex; flex-wrap:wrap; align-items:center; gap:12px 20px; }
  .b-link { font-weight:600; text-decoration:underline; }
  .b-img-row { display:flex; align-items:center; gap:12px; }
  .b-sec[style*="text-align:center"] .b-img-row { justify-content:center; }
  .b-img-row img { width:auto; }
  .b-chip { display:inline-block; background:#ffffff; border-radius:12px; padding:12px 16px; }
  .b-chip img { border-radius:0; }
  .b-beside { font-size:22px; font-weight:700; }
  @media (max-width:600px) {
    .b-ms { grid-template-columns:1fr 1fr; }
    .b-display { font-size:36px; }
    .b-sec { padding:28px 20px !important; }
  }
</style>
</head>
<body>
<main class="page">
<h1>Title</h1>
<h2>Sub <a href="https://a.test">link</a></h2>
<h3>Plain heading</h3>
<h1 class="b-display">Big</h1>
<div class="b-text"><p>Legacy <strong>markdown</strong> {{first_name}}</p>
</div>
<p>Hello <a href="https://b.test">there</a>{{first_name}}</p>
<p><br></p>
<ul><li>One</li><li>Two</li></ul>
<ol><li>One</li><li>Two</li></ol>
<ol class="b-steps"><li>A</li><li>B</li><li>C</li></ol>
<blockquote>Quoted</blockquote>
<div class="b-callout">Note</div>
<p class="b-eyebrow"><span class="b-eyebrow-rule"></span>Label</p>
<p class="b-eyebrow accent"><span class="b-eyebrow-rule"></span>Accent label</p>
<div class="b-ms rule" style="--n:3"><div><strong>1</strong><span>a</span></div><div><strong>2</strong><span>b</span></div><div><strong>3</strong><span>c</span></div></div>
<div class="b-ms" style="--n:2"><div><strong>x</strong><span>y</span></div><div><strong></strong><span></span></div></div>
<div class="b-img"><img src="https://img.test/a.png" alt="A" loading="lazy"></div>
<div class="b-img"><a href="https://c.test"><img src="https://img.test/b.png" alt="B" loading="lazy" style="max-width:200px"></a></div>
<div class="b-img"><img src="https://img.test/c.png" alt="C" loading="lazy" style="width:40%"></div>
<div class="b-img b-img-row"><span class="b-chip"><img src="https://img.test/d.png" alt="D" loading="lazy" style="max-width:48px"></span></div>
<div class="b-img b-img-row"><img src="https://img.test/e.png" alt="E" loading="lazy"><span class="b-beside">Wordmark</span></div>
<div class="b-btn" style="text-align:left"><a class="btn" href="https://d.test">Left</a></div>
<div class="b-btn" style="text-align:center"><a class="btn" href="https://d.test">Centre</a></div>
<div class="b-btn b-btn-row" style="text-align:right;justify-content:flex-end"><a class="btn" href="https://d.test">Right</a><a class="b-link" href="mailto:a@b.test">or here</a></div>

<hr>
<div style="height:12px"></div>
<div style="height:56px"></div>
<p>Hot only</p>
<div class="cols cols-2"><div class="col"><p>Left cell</p></div>
<div class="col"><div class="b-img"><img src="https://img.test/f.png" alt="F" loading="lazy"></div></div></div>
<div class="cols cols-3"><div class="col"><h3>x</h3></div>
<div class="col"></div>
<div class="col"><div class="b-btn" style="text-align:center"><a class="btn" href="https://e.test">Go</a></div></div></div>

<section class="b-sec full" style="background:#1a9ec4;color:#000000;padding:44px 40px;--acc:#000000;--hair:#e3e3e3;--btn-bg:#000000;--btn-fg:#1a9ec4;"><h1>Title</h1>
