exports[`renderers > canvas: full-width backdrop table + centred card; font size and link colour reach the blocks 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  body { margin:0; padding:0; background:#ffffff; }
  .email { max-width:640px; margin:0; padding:32px 24px; text-align:left;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    font-size:16px; line-height:1.6; color:#1f2328; }
  .email h1 { font-size:24px; font-weight:700; margin:0 0 16px; line-height:1.25; }
  .email h2 { font-size:18px; font-weight:700; margin:28px 0 10px; line-height:1.3; }
  .email h3 { font-size:16px; font-weight:700; margin:22px 0 8px; }
  .email p { margin:0 0 16px; }
  .email ul, .email ol { margin:0 0 16px; padding-left:22px; }
  .email li { margin:0 0 8px; }
  .email a { color:#2563eb; text-decoration:none; }
  .email a:hover { text-decoration:underline; }
  .email img { max-width:100%; height:auto; }
  .email blockquote { margin:0 0 16px; padding:4px 0 4px 16px;
    border-left:3px solid #e5e7eb; color:#57606a; }
  .email hr { border:none; border-top:1px solid #e5e7eb; margin:24px 0; }
  .email code { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:14px;
    background:#f4f4f5; padding:1px 5px; border-radius:4px; }
  .signature { margin-top:28px; font-size:14px; line-height:1.5; }
  .signature a { text-decoration:none; }
  .footer { max-width:640px; margin:0; padding:16px 24px 40px; text-align:left;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    font-size:12px; line-height:1.5; color:#8b949e; }
  .footer a { color:#8b949e; text-decoration:underline; }
  @media (max-width:480px) {
    .ds-display { font-size:34px !important; line-height:1.1 !important; }
    .ds-sec-lg { padding:28px 20px !important; }
    .ds-sec-md { padding:22px 18px !important; }
    .ds-cta-link { display:block !important; }
  }
</style>
<style>
  .email a { color:#ce423b; }
  .footer a { color:#8b949e; }
</style>
</head>
<body style="margin:0;padding:0;background-color:#0b1f3a;">

<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#0b1f3a" style="background-color:#0b1f3a;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" align="center" bgcolor="#ffffff" style="width:100%;max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:16px;border-collapse:separate;overflow:hidden;"><tr>
<td class="email" style="max-width:none;padding:0;color:#333333;font-size:17px;border-radius:16px;">
<!--ds-canvas--><p style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.6;margin:0 0 16px;">Hi <a href="https://a.test" style="color:#ce423b;text-decoration:underline;">there</a></p>
<div class="signature" style="padding:0 24px 24px;"><div class="missive_signature"><div>--</div><div><strong>Jane Doe</strong></div><div><span style="font-size: 13px">Founder</span></div><div><br></div><div><a href="https://ourco.example"><strong><span style="color: #005CD4">Ourco</span></strong></a><strong><span style="color: rgb(33, 33, 33)">&nbsp;</span></strong><span style="color: rgb(33, 33, 33)">—<span style="font-size: 13px">&nbsp;</span></span><em><span style="color: rgb(33, 33, 33)"><span style="font-size: 13px">Built For Where You're Growing</span></span></em></div><div><a href="https://social.example.net/ourco"><span style="color: #005CD4"><span style="font-size: 13px">@ourco</span></span></a><strong><span style="color: #005CD4"><span style="font-size: 13px">&nbsp;</span></span></strong><span style="font-size: 13px">|</span><span style="color: #005CD4"><span style="font-size: 13px">&nbsp;</span></span><a href="mailto:support@ourco.example"><span style="color: #005CD4"><span style="font-size: 13px">Get Support</span></span></a><span style="color: #005CD4"><span style="font-size: 13px">&nbsp;| </span></span><a href="https://ourco.example/book/"><span style="color: #005CD4"><span style="font-size: 13px">Book a Call</span></span></a></div></div></div>
</td></tr></table>
<div class="footer" style="max-width:600px;margin:0 auto;color:#8b949e;">
Don't want these emails? <a href="%%UNSUB_URL%%">Unsubscribe here</a>.
</div>
</td></tr></table>
</body>
</html>"
`;

