	"bulk": {
		"extends": "crm",
		"lists": [{ "name": "Webinar 2026", "ref": "webinar-2026-list" }],
		"sql": [
			"WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 30) INSERT INTO contacts (email, first_name, last_name, subscribed, source) SELECT 'guest' || i || '@webinar.example.com', 'Guest', 'Number ' || i, 1, 'webinar' FROM n",
			"INSERT INTO list_members (list_id, contact_id) SELECT {{ref:list.webinar-2026-list}}, id FROM contacts WHERE email LIKE '%@webinar.example.com'"
		]
	}
